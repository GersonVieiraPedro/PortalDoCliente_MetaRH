{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4789-a1b2-c3d4e5f67890",
		"name": "MetaRH - Financeiro (Notas Fiscais)",
		"description": "Collection para testar a API de Notas Fiscais (Duplicatas) do Portal MetaRH.\n\n**Configuração:**\n1. Configure as variáveis de ambiente (baseURL, token)\n2. Faça login para obter o token JWT\n3. Teste os endpoints de notas fiscais\n\n**Última atualização:** 2025-10-13",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salva o token automaticamente nas variáveis de ambiente",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set(\"token\", jsonData.access_token);",
									"    pm.environment.set(\"token_type\", jsonData.token_type);",
									"    console.log(\"Token salvo com sucesso!\");",
									"} else {",
									"    console.log(\"Erro ao fazer login\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"seu.email@exemplo.com\",\n  \"senha\": \"sua_senha\"\n}"
						},
						"url": {
							"raw": "{{baseURL}}/usuarios/login",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"usuarios",
								"login"
							]
						},
						"description": "Endpoint de login para obter o token JWT.\n\n**Atenção:** Substitua o email e senha pelos dados reais antes de executar."
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticação para obter o token JWT necessário para acessar a API."
		},
