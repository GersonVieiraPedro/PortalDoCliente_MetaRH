# ============================================
# DATABASE CONFIGURATION
# ============================================

# Primary Portal Database (SQLAlchemy ORM)
DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net/PortalCliente?driver=ODBC+Driver+18+for+SQL+Server

# ============================================
# JWT AUTHENTICATION
# ============================================

SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
EXPIRES_IN_MINUTES=600

# ============================================
# AZURE BLOB STORAGE
# ============================================

ACCOUTE_URL=https://youraccount.blob.core.windows.net
CONTAINER=portal-images
KEY=your-azure-storage-key

# ============================================
# LEGACY ERP DATABASE (ODBC)
# ============================================

DRIVER=ODBC Driver 18 for SQL Server
SERVER=server.database.windows.net
DATABASE=INTEGRA_METASP
USER=your_user
PASSWORD=your_password

# ============================================
# EMAIL CONFIGURATION - RPS (Aprovação/Reprovação)
# ============================================

# Feature toggle: habilitar/desabilitar envio de emails de RPS
# Valores aceitos: true (ativo) ou false (desativado)
EMAIL_RPS_ATIVO=true

# Email remetente para notificações de RPS (Gmail ou outro provedor SMTP)
EMAIL_RPS_REMETENTE=seu.email@gmail.com

# Senha de aplicativo (App Password) - NÃO use a senha da conta
# Para Gmail: https://myaccount.google.com/apppasswords
EMAIL_RPS_SENHA=abcd efgh ijkl mnop

# Lista de destinatários para notificações de RPS (separados por vírgula)
# Exemplo: financeiro@metarh.com,gestao@metarh.com,auditoria@metarh.com
EMAIL_DESTINATARIOS_RPS=financeiro@metarh.com,gestao@metarh.com
